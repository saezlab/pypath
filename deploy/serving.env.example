# Absolute artifact root; existing Parquets/indexes can stay outside this checkout.
DATA_DIR=/srv/omnipath/data
COMPOSE_PROJECT_NAME=omnipath-serving
API_IMAGE=omnipath-api:local
WEB_IMAGE=omnipath-web:local
API_PORT=8085
WEB_PORT=8082
DATA_PORT=8080
PUBLIC_DOMAIN=omnipath.example.org
DATA_DOMAIN=data.omnipath.example.org
PUBLIC_DATA_URL=https://data.omnipath.example.org
PROXY_NETWORK=dokploy-network
TLS_RESOLVER=letsencrypt
ROUTE_PRIORITY=100

# Per-process query pool and container budget. Size these together.
API_QUERY_CONCURRENCY=2
API_QUERY_THREADS=2
API_QUERY_MEMORY=1GB
API_QUERY_WAIT_SECONDS=30
API_MEMORY_LIMIT=4g
API_CPUS=4
