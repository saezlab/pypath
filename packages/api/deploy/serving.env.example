# Absolute artifact root; existing Parquets/indexes can stay outside this checkout.
DATA_DIR=/srv/omnipath/data
COMPOSE_PROJECT_NAME=omnipath-serving
API_IMAGE=omnipath-api:local
WEB_IMAGE=omnipath-web:local
API_PORT=8085
WEB_PORT=8082
DATA_PORT=8080
PUBLIC_DOMAIN=omnipath.example.org
DATA_DOMAIN=data.omnipath.example.org
PUBLIC_DATA_URL=https://data.omnipath.example.org
PROXY_NETWORK=dokploy-network
TLS_RESOLVER=letsencrypt
ROUTE_PRIORITY=100

# The container's budget. The API sizes its query pool from it: a query slot per CPU,
# one DuckDB thread for the database (each query runs on its caller's thread), and 75%
# of the memory for DuckDB (7 CPUs and 13 GB: 7 slots sharing about 9.75 GB). A full
# release serves well from 13 GB.
API_CPUS=4
API_MEMORY_LIMIT=4g
API_QUERY_WAIT_SECONDS=30
# Overrides, only for a measured reason: slots, the database's threads, memory per slot.
# API_QUERY_CONCURRENCY=7
# API_QUERY_THREADS=1
# API_QUERY_MEMORY=1400MB
