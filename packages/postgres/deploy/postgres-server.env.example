# Starting values for a large dedicated build server; size to available RAM/CPU.
# Copy to a private ignored deploy/*.env file and choose a password.
POSTGRES_PASSWORD=
POSTGRES_PORT=55432
POSTGRES_SHARED_BUFFERS=4GB
POSTGRES_EFFECTIVE_CACHE_SIZE=128GB
POSTGRES_WORK_MEM=128MB
POSTGRES_MAINTENANCE_WORK_MEM=2GB
POSTGRES_MAX_WORKER_PROCESSES=24
POSTGRES_MAX_PARALLEL_WORKERS=16
POSTGRES_MAX_LOCKS_PER_TRANSACTION=512
POSTGRES_SHM_SIZE=1gb
